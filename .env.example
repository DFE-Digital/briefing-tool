# Copy to .env at the repository root (never committed) and fill in. In Azure Container Apps set the same names as the container's
# environment variables, with the secret ones as Container Apps secrets (or Key Vault references).
# A ":" in a setting's name is "__" here.

# Development lets the app keep data protection keys in the container, unencrypted. Anything else needs the two
# DataProtection settings below.
ASPNETCORE_ENVIRONMENT=Development

# Sign-in (Entra ID). Add http://localhost:8080/signin-oidc, or the Container App's address, as a redirect URI.
AzureAd__ClientID=
AzureAd__TenantID=

# Foundry
AiAgents__Foundry__Endpoint=
AiAgents__Foundry__DefaultModel=
AiAgents__Authentication__TenantId=
AiAgents__Authentication__ClientId=
AiAgents__Authentication__ClientSecret=

# Azure AI Search
AiAgents__AISearch__Endpoint=
AiAgents__AISearch__Authentication__TenantId=
AiAgents__AISearch__Authentication__ClientId=
AiAgents__AISearch__Authentication__ClientSecret=

# Guardrails: leave SubscriptionId empty to run without them
AiAgents__Guardrails__SubscriptionId=
AiAgents__Guardrails__ResourceGroup=

# The blob container holding the run slots shared by every replica (Development too). The app's identity needs
# Storage Blob Data Contributor on it.
AiAgents__GlobalConcurrency__BlobContainerUri=

# Token usage, logs and traces
APPLICATIONINSIGHTS_CONNECTION_STRING=

# Outside Development: a folder every replica mounts (an Azure Files volume in Container Apps), writable by the
# container's user (UID 1654), and the URI of the Key Vault key that encrypts the keys kept there.
# DataProtection__Path=/mnt/dataprotection
# DataProtection__KeyVaultKey=https://<vault>.vault.azure.net/keys/<key>
