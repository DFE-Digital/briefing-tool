<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- OpenAI's Responses API types (e.g. ResponseTool, used to build the web search agent's
         tool definition) are marked experimental (OPENAI001) pending the SDK's own stabilization. -->
    <NoWarn>$(NoWarn);OPENAI001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="GovUK.Dfe.AI.Agents" Version="0.0.1-prerelease.151" />
    <PackageReference Include="GovUK.Dfe.AI.Agents.AISearch" Version="0.0.1-prerelease.109" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.12" />
    <PackageReference Include="ReverseMarkdown" Version="6.2.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Dfe.Briefing.Tool.Domain\Dfe.Briefing.Tool.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Dfe.Briefing.Tool.Application.Tests" />
  </ItemGroup>

</Project>
