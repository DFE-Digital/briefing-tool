<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UserSecretsId>6527a5d4-93b7-4b0c-bd1a-bdffed4bff00</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!-- The judge, release gate and Responsible AI quality gate: only the gate uses them, so the web app doesn't ship them. -->
    <PackageReference Include="GovUK.Dfe.AI.Agents.Evaluation" Version="0.0.5" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="11.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Dfe.Briefing.Tool.Infrastructure\Dfe.Briefing.Tool.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The gate tests the agents exactly as the web app runs them: the shared settings and prompts both come from
         Infrastructure (appsettings.shared.json and Prompts), copied in through its project reference. -->
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="TestCases\**\*.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Baselines\**\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Dfe.Briefing.Tool.ReleaseGate.Tests" />
  </ItemGroup>

</Project>
