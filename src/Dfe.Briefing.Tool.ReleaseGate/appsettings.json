// The release gate's own settings. The agents' settings, shared with the web app, are in
// Dfe.Briefing.Tool.Infrastructure/appsettings.shared.json, loaded before this file: any value here overrides them.
{
  "Logging": {
    "LogLevel": {
      "Default": "Information"
    }
  },
  "AiAgents": {
    "Evaluation": {
      "SampleRate": 0,
      "ReleaseGate": {
        "BaselinesDirectory": "Baselines",
        "ReportsDirectory": "evaluation-reports",
        "Metrics": [ "Groundedness", "Relevance" ],
        "MinimumScore": 3.0,
        "Tolerance": 0.2,
        "MaxGroupGap": 1.0,
        "Repeats": 3,
        "MaxParallelTestRuns": 4,
        "RefusalPhrases": [ "No information available" ],
        "PublishToFoundry": true
      }
    }
  }
}
