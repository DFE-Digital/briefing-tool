{
  "Logging": {
    "LogLevel": {
      "Default": "Information"
    }
  },
  "AiAgents": {
    "MaxRunsPerInstance": 24,
    "Evaluation": {
      "SampleRate": 0,
      "ReleaseGate": {
        "BaselinesDirectory": "Baselines",
        "ReportsDirectory": "evaluation-reports",
        "Metrics": [ "Groundedness", "Relevance" ],
        "MinimumScore": 3.0,
        "Tolerance": 0.2,
        "MaxGroupGap": 1.0,
        "Repeats": 3,
        "MaxParallelTestRuns": 8,
        "PublishToFoundry": true
      },
      "QualityGate": {
        "RequiredGroups": [ "primary", "secondary", "special", "trust" ],
        "MinimumCasesPerGroup": 3,
        "MaxGroupPassRateGap": 0.2,
        "MinimumReadingEase": 30,
        "MaxAverageSentenceWords": 25,
        "MaxRiskAcceptanceDays": 90
      }
    }
  }
}
