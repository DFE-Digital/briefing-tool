{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Dfe.Briefing.Tool.ReleaseGate": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": { "outputTemplate": "{Level:u4}: {SourceContext} {Message:lj}{NewLine}{Exception}" }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "APPLICATIONINSIGHTS_CONNECTION_STRING": "",
  "AiAgents": {
    "Foundry": {
      "Endpoint": "",
      "DefaultModel": ""
    },
    "Authentication": {
      "TenantId": "",
      "ClientId": "",
      "ClientSecret": ""
    },
    "Guardrails": {
      "SubscriptionId": "",
      "ResourceGroup": ""
    },
    "Evaluation": {
      "SampleRate": 0,
      "ReleaseGate": {
        "BaselinesDirectory": "Baselines",
        "ReportsDirectory": "evaluation-reports",
        "Metrics": [ "Groundedness", "Relevance" ],
        "MinimumScore": 3.0,
        "Tolerance": 0.2,
        "MaxGroupGap": 1.0,
        "Repeats": 3,
        "MaxParallelTestRuns": 2,
        "RefusalPhrases": [ "No information available" ],
        "PublishToFoundry": true
      }
    }
  }
}
