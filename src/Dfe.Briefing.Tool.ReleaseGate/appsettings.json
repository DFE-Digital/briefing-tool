{
  "Logging": {
    "LogLevel": {
      "Default": "Error"
    }
  },
  "AiAgents": {
    "MaxRunsPerInstance": 24,
    "MaxWaitToStartRun": 1800, 
    "Evaluation": {
      "SampleRate": 0,
      "ReleaseGate": {
        "BaselinesDirectory": "Baselines",
        "ReportsDirectory": "evaluation-reports",
        "Metrics": [ "Groundedness", "Relevance" ],
        "MinimumScore": 3.5,
        "Tolerance": 0.2,
        "MaxGroupGap": 1.0,
        "Repeats": 3,
        "MaxParallelTestRuns": 12,
        "PublishToFoundry": true,
        "MustNotMention": [
          "**", "</", "| --- |", "## References", "## Sources", "{{city",
          "excellent", "impressive", "As an AI", "I recommend", "We recommend", "Here is the briefing",
          "## Information not available", "More background information", "News and media coverage"
        ]
      },
      "QualityGate": {
        "RequiredGroups": [ "primary", "secondary", "special", "trust" ],
        "MinimumCasesPerGroup": 3,
        "MaxGroupPassRateGap": 0.2,
        "MinimumReadingEase": 30,
        "MaxAverageSentenceWords": 25,
        "MaxRiskAcceptanceDays": 90
      }
    }
  }
}
