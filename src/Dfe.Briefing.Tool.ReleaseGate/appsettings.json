{
  "Logging": {
    "LogLevel": {
      "Default": "Information"
    }
  },
  "TestCases": {
    "Today": "2026-11-06"
  },
  "AiAgents": {
    // 12 cases at once, each with its judge's calls, fit in 24 slots. The gate is a batch job, so a run waits for a slot
    // (up to 30 minutes) rather than fail the release: the default 2 minutes cancelled runs and failed cases.
    "MaxRunsPerInstance": 24,
    "MaxWaitToStartRun": 1800,
    "Evaluation": {
      "SampleRate": 0,
      "ReleaseGate": {
        "BaselinesDirectory": "Baselines",
        "ReportsDirectory": "evaluation-reports",
        "Metrics": [ "Groundedness", "Relevance" ],
        "MinimumScore": 3.0,
        "Tolerance": 0.2,
        "MaxGroupGap": 1.0,
        "Repeats": 3,
        "MaxParallelTestRuns": 12,
        "PublishToFoundry": true,
        // Text no briefing may contain, whatever the case: checked in every evaluation case, plain text, ignoring case.
        "MustNotMention": [
          "**", "</", "| --- |", "## References", "## Sources", "{{city",
          "excellent", "impressive", "As an AI", "I recommend", "We recommend", "Here is the briefing",
          "Information not available", "More background information", "News and media coverage"
        ]
      },
      "QualityGate": {
        "RequiredGroups": [ "primary", "secondary", "special", "trust" ],
        "MinimumCasesPerGroup": 5,
        "MaxGroupPassRateGap": 0.2,
        "MinimumReadingEase": 30,
        "MaxAverageSentenceWords": 25,
        "MaxRiskAcceptanceDays": 90
      }
    }
  }
}
