@page
@model SummaryModel
@{
    var subject = Model.Subject!;
    var hasBriefing = !string.IsNullOrWhiteSpace(Model.BriefingOutput);
    ViewData["Title"] = hasBriefing ? $"Briefing Tool summary of {subject.Name}" : $"Generate AI summary of {subject.Name}";
}

@section BeforeMain {
    <govuk-back-link href="@Url.BackLink(Url.Page("Confirm", new { type = Model.Type, urnOrTrn = subject.UrnOrTrn }))" id="briefing-back-link" hidden="@hasBriefing">Back</govuk-back-link>
}

<section id="briefing-generate" aria-labelledby="briefing-generate-title" hidden="@hasBriefing">
    <h1 class="govuk-heading-l" id="briefing-generate-title">Generate AI summary</h1>

    <partial name="_SubjectSummaryList" model="new SubjectSummaryListModel(Model)" />

    <form method="post" novalidate id="briefing-form">
        <input type="hidden" name="Type" value="@Model.Type" />
        <input type="hidden" name="UrnOrTrn" value="@subject.UrnOrTrn" />

        <govuk-checkboxes for="AcceptDisclaimer" id="briefing-disclaimer-group" class="app-disclaimer">
            <govuk-checkboxes-fieldset>
                <govuk-checkboxes-fieldset-legend class="govuk-fieldset__legend--m">AI disclaimer</govuk-checkboxes-fieldset-legend>

                <govuk-checkboxes-item value="true" checked="@Model.AcceptDisclaimer" label-class="govuk-!-font-weight-bold">
                    I understand that I need to apply professional judgement when using content generated by AI in my work.
                    <govuk-checkboxes-item-hint>
                        <a asp-page="/AiSummaries" class="govuk-link">Read more about the Briefing Tool and AI summaries</a>
                    </govuk-checkboxes-item-hint>
                </govuk-checkboxes-item>
            </govuk-checkboxes-fieldset>
        </govuk-checkboxes>

        <div class="govuk-button-group">
            <govuk-button type="submit" id="briefing-submit">Generate</govuk-button>
            <a asp-page="Type" class="govuk-link">Choose a different establishment</a>
        </div>
    </form>
</section>

@* The summary, shown while it generates and once it's done. *@
<section id="briefing-summary" aria-labelledby="briefing-summary-title" hidden="@(!hasBriefing)">
    <h1 class="govuk-heading-l" id="briefing-summary-title" tabindex="-1">Briefing Tool summary</h1>

    <partial name="_SubjectSummaryList" model="new SubjectSummaryListModel(Model, Model)" />

    @* Progress while the summary generates. *@
    <div id="briefing-status" class="app-briefing-status" hidden>
        <h2 class="govuk-heading-m app-briefing-status__heading">
            <output>
                <span class="app-spinner" aria-hidden="true"></span>
                <span id="briefing-status-title">Generating summary...</span>
            </output>
        </h2>
        <ul id="briefing-status-list" class="govuk-list app-briefing-status__list" role="log" aria-live="polite"></ul>
    </div>

    @* The briefing, between two AI warnings. *@
    <div id="briefing-result" hidden="@(!hasBriefing)">
        <partial name="_BriefingCheckWarning" />

        <div class="app-briefing-panel">
            <div id="briefing-output-container">
                @if (hasBriefing)
                {
                    <div class="briefing-output">
                        @Html.Raw(Model.BriefingOutput)
                    </div>
                }
            </div>

            @* The web search findings, under the briefing in the same panel - see renderWebSearchFindings in briefing.js. *@
            <div id="web-search-output-container" class="app-web-search-output" hidden>
                <h2 class="govuk-heading-m" id="web-search-title" tabindex="-1">Further context</h2>
                <div id="web-search-output"></div>
            </div>

            @* Shown by briefing.js: copying needs JavaScript. It copies the briefing and the further context. *@
            <p class="govuk-body govuk-!-margin-bottom-0" id="briefing-copy" hidden>
                <button type="button" class="app-link-button govuk-link" id="briefing-copy-button">Copy this summary to clipboard</button>
                <output id="briefing-copy-status" class="govuk-!-margin-left-2"></output>
            </p>
        </div>

        <partial name="_BriefingCheckWarning" />
    </div>

    @* Offered at the end of a summary: the web search only runs if the person chooses it - see briefing.js. *@
    <div id="web-search-offer" class="govuk-!-margin-top-6" hidden>
        <h2 class="govuk-heading-s" id="web-search-offer-title" tabindex="-1">Would you like to see more information?</h2>
        <p class="govuk-body">
            The Briefing Tool can also search for information about this @Model.SubjectNoun online. These will be
            separate results from the last search.
        </p>
        <govuk-button type="button" id="web-search-yes">Generate</govuk-button>
    </div>

    @* Progress while the web search runs, below the offer it replaces. *@
    <div id="web-search-status" class="app-briefing-status" hidden>
        <h2 class="govuk-heading-m app-briefing-status__heading">
            <output>
                <span class="app-spinner" aria-hidden="true"></span>
                <span>Searching the web...</span>
            </output>
        </h2>
        <ul id="web-search-status-list" class="govuk-list app-briefing-status__list" role="log" aria-live="polite"></ul>
    </div>

    <div id="briefing-sources" hidden="@(!hasBriefing)">
        <partial name="_InformationSources" model="Model" />
    </div>
</section>
