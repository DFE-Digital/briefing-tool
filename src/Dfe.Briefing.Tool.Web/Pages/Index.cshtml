@page
@model IndexModel
@{
    ViewData["Title"] = "Generate an AI summary of an establishment";
}

<div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
        <h1 class="govuk-heading-xl">Generate an AI summary of an establishment</h1>

        <p class="govuk-body">Use this service to:</p>
        <ul class="govuk-list govuk-list--bullet">
            <li>generate an AI summary of a school, academy trust, or other education establishment</li>
            <li>quickly understand key performance, attendance and contextual information</li>
            <li>access attainment and Ofsted data in one place</li>
            <li>view socio-economic characteristics alongside local and national averages</li>
            <li>use the summary as a starting point for briefing preparation and further investigation</li>
        </ul>

        <h2 class="govuk-heading-m">Before you start</h2>
        <p class="govuk-body">Before generating a summary, you should:</p>
        <ul class="govuk-list govuk-list--bullet">
            <li>have the name and URN or TRN of the establishment you want to search for</li>
            <li>be aware that summaries are generated by AI and may contain errors or omissions</li>
            <li>verify important information against the source data before using it in a briefing or decision-making process</li>
            <li>ensure you comply with departmental guidance on the use of AI-generated content</li>
        </ul>

        <p class="govuk-body">
            <a asp-page="/AiSummaries" class="govuk-link">Read more about AI-generated summaries and the data they use</a>
        </p>

        <a asp-page="/Briefing" role="button" draggable="false" class="govuk-button govuk-button--start" data-module="govuk-button">
            Start now
            <svg class="govuk-button__start-icon" xmlns="http://www.w3.org/2000/svg" width="17.5" height="19" viewBox="0 0 33 40" aria-hidden="true" focusable="false">
                <path fill="currentColor" d="M0 0h13l20 20-20 20H0l20-20z" />
            </svg>
        </a>
    </div>
</div>
