@page
@model IndexModel
@{
    ViewData["Title"] = "Generate a briefing";
    var urnInvalid = ViewData.ModelState["Input.SchoolUrnOrTrustTrn"]?.Errors.Count > 0;
    var nameInvalid = ViewData.ModelState["Input.SchoolOrTrustName"]?.Errors.Count > 0;
}

<partial name="_ValidationSummary" />

<div id="briefing-error-summary">
    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="govuk-error-summary" data-module="govuk-error-summary" aria-labelledby="briefing-error-title" role="alert" tabindex="-1">
            <h2 class="govuk-error-summary__title" id="briefing-error-title">There is a problem</h2>
            <div class="govuk-error-summary__body">
                <ul class="govuk-list govuk-error-summary__list">
                    <li>@Model.ErrorMessage</li>
                </ul>
            </div>
        </div>
    }
</div>

<h1 class="govuk-heading-xl">Generate a briefing</h1>
<govuk-details>
    <govuk-details-summary>
        <span class="govuk-details__summary-text">Instructions</span>
    </govuk-details-summary>
    <govuk-details-text>
        <p class="govuk-body">This tool uses AI to give an overview of the data Regions Group holds about a school or trust, including:</p>
        <ul class="govuk-list govuk-list--bullet">
            <li>pupil numbers</li>
            <li>trust make up</li>
            <li>performance details</li>
        </ul>
        <p class="govuk-body">You must enter either a school's six digit URN or a trust's seven digit TRN, then its name.</p>
        <p class="govuk-body">Click 'Search' when you're done.</p>
    </govuk-details-text>
</govuk-details>
<div class="govuk-grid-row">
    <div class="govuk-grid-column-one-third">
        <form method="post" novalidate id="briefing-form">
            <div class="govuk-form-group @(urnInvalid == true ? "govuk-form-group--error" : "")">
                <label asp-for="Input.SchoolUrnOrTrustTrn" class="govuk-label">School URN or trust TRN</label>
                <span asp-validation-for="Input.SchoolUrnOrTrustTrn" id="Input_SchoolUrnOrTrustTrn-error" class="govuk-error-message"></span>
                <input asp-for="Input.SchoolUrnOrTrustTrn" class="govuk-input @(urnInvalid == true ? "govuk-input--error" : "")" aria-describedby="Input_SchoolUrnOrTrustTrn-error" />
            </div>

            <div class="govuk-form-group @(nameInvalid == true ? "govuk-form-group--error" : "")">
                <label asp-for="Input.SchoolOrTrustName" class="govuk-label">School or trust name</label>
                <span asp-validation-for="Input.SchoolOrTrustName" id="Input_SchoolOrTrustName-error" class="govuk-error-message"></span>
                <input asp-for="Input.SchoolOrTrustName" class="govuk-input @(nameInvalid == true ? "govuk-input--error" : "")" aria-describedby="Input_SchoolOrTrustName-error" />
            </div>

            <div class="govuk-form-group">
                <div class="govuk-checkboxes" data-module="govuk-checkboxes">
                    <div class="govuk-checkboxes__item">
                        <input class="govuk-checkboxes__input" asp-for="Input.AllowWebSearch" type="checkbox" />
                        <label class="govuk-label govuk-checkboxes__label" asp-for="Input.AllowWebSearch">
                            Include a web search for current, publicly available information
                        </label>
                    </div>
                </div>
            </div>

            <div class="govuk-button-group">
                <button type="submit" class="govuk-button" data-module="govuk-button" id="briefing-submit">Search</button>
                <button type="button" class="govuk-button govuk-button--secondary" data-module="govuk-button"
                        id="briefing-clear" hidden="@(string.IsNullOrWhiteSpace(Model.BriefingOutput))">
                    Clear briefing
                </button>
            </div>
        </form>
    </div>

    <div class="govuk-grid-column-two-thirds">
        <div id="briefing-status" class="app-briefing-status" hidden>
            <h2 class="govuk-heading-m app-briefing-status__heading">
                <output>
                    <span class="app-spinner" aria-hidden="true"></span>
                    Generating briefing...
                </output>
            </h2>
            <ul id="briefing-status-list" class="govuk-list app-briefing-status__list" role="log" aria-live="polite"></ul>
        </div>

        @* Shown after every briefing, below its References list - see the 'complete' handler in index.js. *@
        <template id="briefing-check-warning">
            <partial name="_BriefingCheckWarning" />
        </template>

        <div id="briefing-output-container">
            @if (!string.IsNullOrWhiteSpace(Model.BriefingOutput))
            {
                <div class="briefing-output">
                    @Html.Raw(Model.BriefingOutput)
                </div>
                <partial name="_BriefingCheckWarning" />
            }
        </div>
    </div>
</div>
