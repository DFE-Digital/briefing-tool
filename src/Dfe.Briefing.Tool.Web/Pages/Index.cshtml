@page
@model IndexModel
@{
    ViewData["Title"] = "Generate an AI summary of an establishment";
}

<h1 class="govuk-heading-xl">Get an AI summary of a school or trust</h1>

<p class="govuk-body">Use this service create a summary of a school or trust's:</p>
<ul class="govuk-list govuk-list--bullet">
    <li>attendance</li>
    <li>Ofsted ratings</li>
    <li>performance</li>
    <li>comparison against national averages</li>
    <li>SEND and free school meal provision</li>
</ul>

<h2 class="govuk-heading-m">Before you start</h2>
<p class="govuk-body">You will need:</p>
<ul class="govuk-list govuk-list--bullet">
    <li>the URN for summaries about schools</li>
    <li>the TRN for summaries about trusts</li>
    <li>the name of the school or trust</li>
</ul>

<h2 class="govuk-heading-m">You must check all AI generated content before you use it in your work</h2>
<p class="govuk-body">
    <a asp-page="/AiSummaries" class="govuk-link">Read more about AI-generated summaries and the data they use</a>
</p>

<govuk-button-link href="@Url.Page("/Briefing/Type")" is-start-button="true">Start now</govuk-button-link>
