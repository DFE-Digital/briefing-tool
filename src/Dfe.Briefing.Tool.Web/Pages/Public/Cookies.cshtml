@page "/cookies"
@model Dfe.Briefing.Tool.Web.Pages.Public.Cookies

@{
    ViewBag.Title = "Cookies";
    Layout = "Shared/_Layout";
}

@section BeforeMain {
    <govuk-back-link href="@Model.ReturnPath">Back</govuk-back-link>
}

@if (Model.PreferencesSet)
{
    <govuk-notification-banner class="govuk-notification-banner--success">
        <govuk-notification-banner-title>
            Success
        </govuk-notification-banner-title>
        <h3>
            You've set your cookie preferences. <a class="govuk-notification-banner__link"
                data-test="success-banner-return-link" href="@Html.Encode(Model.ReturnPath)">
                Go back to the page you were looking
                at
            </a>.
        </h3>
    </govuk-notification-banner>
}

<h1 class="govuk-heading-xl">Cookie preferences</h1>
<p class="govuk-body">
    Cookies are small files saved on your phone, tablet or computer when you visit a website.
</p>

<p class="govuk-body">
    We use cookies to make this website work and collect information about how you use it.
</p>

<h2 class="govuk-heading-l">Essential cookies</h2>
<p class="govuk-body">
    Essential cookies keep your information secure while you use this service. We do not need
    to ask permission to use them
</p>
<govuk-table aria-label="Essential cookies">
    <govuk-table-head>
        <govuk-table-head-cell>Name</govuk-table-head-cell>
        <govuk-table-head-cell>Purpose</govuk-table-head-cell>
        <govuk-table-head-cell>Expires</govuk-table-head-cell>
    </govuk-table-head>
    <govuk-table-row>
        <govuk-table-cell>ASLBSA</govuk-table-cell>
        <govuk-table-cell>Balances the load on our servers</govuk-table-cell>
        <govuk-table-cell>With browser settings (session)</govuk-table-cell>
    </govuk-table-row>
    <govuk-table-row>
        <govuk-table-cell>ASLBSACORS</govuk-table-cell>
        <govuk-table-cell>Balances the load on our servers</govuk-table-cell>
        <govuk-table-cell>With browser settings (session)</govuk-table-cell>
    </govuk-table-row>
    <govuk-table-row>
        <govuk-table-cell>BriefingAntiForge</govuk-table-cell>
        <govuk-table-cell>Secures you and our website against Cross Site Request Forgery (CSRF)</govuk-table-cell>
        <govuk-table-cell>With browser settings (session)</govuk-table-cell>
    </govuk-table-row>
    <govuk-table-row>
        <govuk-table-cell>BriefingCookieConsent</govuk-table-cell>
        <govuk-table-cell>Stores your consent to optional cookies</govuk-table-cell>
        <govuk-table-cell>One year</govuk-table-cell>
    </govuk-table-row>
    <govuk-table-row>
        <govuk-table-cell>BriefingName</govuk-table-cell>
        <govuk-table-cell>Keeps you signed in</govuk-table-cell>
        <govuk-table-cell>With browser settings (session)</govuk-table-cell>
    </govuk-table-row>
    <govuk-table-row>
        <govuk-table-cell>.AspNetCore.Correlation.OpenIdConnect.*</govuk-table-cell>
        <govuk-table-cell>Used briefly while you're signing in, to protect against Cross Site Request Forgery (CSRF)</govuk-table-cell>
        <govuk-table-cell>Deleted once sign-in completes</govuk-table-cell>
    </govuk-table-row>
    <govuk-table-row>
        <govuk-table-cell>.AspNetCore.OpenIdConnect.Nonce.*</govuk-table-cell>
        <govuk-table-cell>Used briefly while you're signing in, to stop your sign-in request being replayed</govuk-table-cell>
        <govuk-table-cell>Deleted once sign-in completes (up to 15 minutes)</govuk-table-cell>
    </govuk-table-row>
</govuk-table>
<h2 class="govuk-heading-l">Analytics cookies (optional)</h2>
<p class="govuk-body">
    With your permission, we use Microsoft Application Insights to collect data about how you
    use this website. This information helps us to improve our website.
</p>
<p class="govuk-body">
    Application Insights is not allowed to use or share our analytics data with anyone. It
    stores information about:
</p>
<ul class="govuk-list govuk-list--bullet">
    <li>how you got to this website</li>
    <li>the pages you visit on this website and how long you spend on them</li>
    <li>any errors you see while using this website</li>
    <li>what you click on while you are visiting the website</li>
</ul>


<govuk-table aria-label="Application Insights cookies">
    <govuk-table-head>
        <govuk-table-head-cell>Name</govuk-table-head-cell>
        <govuk-table-head-cell>Purpose</govuk-table-head-cell>
        <govuk-table-head-cell>Expires</govuk-table-head-cell>
    </govuk-table-head>
    <govuk-table-row>
        <govuk-table-cell>ai_session</govuk-table-cell>
        <govuk-table-cell>This helps us track activity happening over a single browser session</govuk-table-cell>
        <govuk-table-cell>1 hour</govuk-table-cell>
    </govuk-table-row>
    <govuk-table-row>
        <govuk-table-cell>ai_user</govuk-table-cell>
        <govuk-table-cell>This helps us to identify the number of distinct users accessing the site over time by tracking if you've visited before</govuk-table-cell>
        <govuk-table-cell>1 year</govuk-table-cell>
    </govuk-table-row>
    <govuk-table-row>
        <govuk-table-cell>ai_authuser</govuk-table-cell>
        <govuk-table-cell>This helps us to identify authenticated users and how they interact with the site</govuk-table-cell>
        <govuk-table-cell>When you close your browser</govuk-table-cell>
    </govuk-table-row>
</govuk-table>
<form method="post">
    <input type="hidden" name="returnUrl" value="@Html.Encode(Model.ReturnPath)" />
    <govuk-radios name="consent">
        <govuk-radios-fieldset>
            <govuk-radios-fieldset-legend class="govuk-fieldset__legend--m">
                <h3 class="govuk-fieldset__heading">Do you want to accept analytics cookies?</h3>
            </govuk-radios-fieldset-legend>

            <govuk-radios-item id="cookie-consent-accept" value="true" checked="@(Model.Consent == true)">Yes</govuk-radios-item>
            <govuk-radios-item id="cookie-consent-deny" value="false" checked="@(Model.Consent == false)">No</govuk-radios-item>
        </govuk-radios-fieldset>
    </govuk-radios>

    <govuk-button type="submit" name="commit" value="Save changes" data-qa="submit">Save changes</govuk-button>
</form>