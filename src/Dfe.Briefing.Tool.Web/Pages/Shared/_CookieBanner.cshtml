@using Dfe.Briefing.Tool.Web.Models
@using Dfe.Briefing.Tool.Web.Services
@{
    var isCookiesPage = Context.Request.Path.Value?.Contains("/cookies", StringComparison.OrdinalIgnoreCase) ?? false;
    var isPost = string.Equals(Context.Request.Method, "POST", StringComparison.OrdinalIgnoreCase);
    var showBanner = !(isCookiesPage && isPost) && !Context.Request.Cookies.ContainsKey(AnalyticsConsentService.ConsentCookieName);
    var returnUrl = Context.Request.Path + Context.Request.QueryString;
}

@* The GOV.UK cookie banner. Its buttons send the choice to the cookies page, as /cookies?consent=true&returnUrl=...,
   which stores it and sends the person back to this page - a plain form, so it works without JavaScript. *@
@if (showBanner)
{
    <form method="get" action="@Url.Page(Links.Public.CookiePreferences.Page)">
        <input type="hidden" name="returnUrl" value="@returnUrl" />
        <govuk-cookie-banner aria-label="Cookie consent" id="appCookieBanner">
            <govuk-cookie-banner-message>
                <govuk-cookie-banner-message-heading>Cookies on the Briefing tool</govuk-cookie-banner-message-heading>
                <govuk-cookie-banner-message-content>
                    <p class="govuk-body">We use some essential cookies to make this service work.</p>
                    <p class="govuk-body">We'd like to set additional cookies so we can understand how people use the service and make improvements.</p>
                </govuk-cookie-banner-message-content>
                <govuk-cookie-banner-message-actions>
                    <govuk-cookie-banner-message-action-button type="submit" name="consent" value="true" text="Accept analytics cookies"
                        data-testid="cookie-banner-accept" />
                    <govuk-cookie-banner-message-action-button type="submit" name="consent" value="false" text="Reject analytics cookies"
                        data-testid="cookie-banner-reject" />
                    <govuk-cookie-banner-message-action-link text="View cookies" data-testid="cookie-banner-link"
                        href="@Url.Page(Links.Public.CookiePreferences.Page, new { returnUrl })" />
                </govuk-cookie-banner-message-actions>
            </govuk-cookie-banner-message>
        </govuk-cookie-banner>
    </form>
}
