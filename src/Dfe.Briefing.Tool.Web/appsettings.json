{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Error"
    },
    "Enrich": [ "FromLogContext" ]
  },
  "APPLICATIONINSIGHTS_CONNECTION_STRING": "",
  "AllowedHosts": "*",
  "Briefing": {
    "MaxEvidencePerSearch": 3
  },
  "AzureAd": {
    "Instance": "https://login.microsoftonline.com/",
    "Domain": "Educationgovuk.onmicrosoft.com",
    "ClientID": "<set client id>",
    "TenantID": "<set tenant id>",
    "CallbackPath": "/signin-oidc"
  },
  "AiAgents": {
    "ApplicationName": "briefing-tool",
    "Foundry": {
      "Endpoint": "",
      "DefaultModel": ""
    },
    "Authentication": {
      "TenantId": "",
      "ClientId": "",
      "ClientSecret": ""
    },
    "PromptFiles": {
      "SystemPrompts": {
        "Establishment": "Prompts/Systems/Establishment.md",
        "RiseConcerns": "Prompts/Systems/RiseConcerns.md",
        "RecastConcerns": "Prompts/Systems/RecastConcerns.md",
        "Trust": "Prompts/Systems/Trust.md",
        "WebSearch": "Prompts/Systems/WebSearch.md",
        "Synthesis": "Prompts/Systems/Synthesis.md"
      },
      "UserPrompts": {
        "Synthesis": "Prompts/Synthesis.md"
      }
    },
    "AISearch": {
      "Endpoint": "",
      "Indexes": [
        {
          "Name": "establishment_index",
          "ContentFields": [
            "establishment_urn",
            "establishment_name",
            "establishment_type",
            "phase_of_education",
            "establishment_age_range",
            "local_authority_name",
            "associated_trust_name",
            "linked_to_diocese",
            "establishment_address",
            "establishment_website",
            "school_capacity",
            "number_on_roll",
            "percentage_seats_occupied",
            "ofsted_all_inspections",
            "ks2_performance_latest",
            "ks2_performance_historic",
            "ks4_performance_latest",
            "ks4_performance_historic",
            "socio_economic_latest",
            "socio_economic_historic"
          ]
        },
        {
          "Name": "trust_index",
          "ContentFields": [
            "trust_name",
            "trust_reference_number",
            "trust_type",
            "group_status",
            "date_established",
            "trust_address",
            "number_in_trust",
            "pipeline_count",
            "aggregate_phase_count",
            "aggregate_demographic",
            "establishments_details",
            "trust_establishments_ofsted_inspections",
            "trust_establishments_key_stage_performance",
            "establishment_socio_economic",
            "trust_governance"
          ]
        },
        { "Name": "rise_concerns_index" },
        { "Name": "recast_concerns_index" }
      ],
      "MinimumRelevanceFilter": 0.2,
      "MaxRetryAttempts": 3
    },
    "MaxEvidenceCharacters": 200000,
    "MaxToolOutputCharacters": 40000,
    "MaxOutputTokensPerRun": 64000,
    "FenceToolOutput": true,
    "MaxConcurrency": 4,
    /*"GlobalConcurrency": {
      "MaxConcurrentRuns": 4,
      "BlobContainerUri": ""
    },*/
    "Pricing": {
      "Currency": "GBP",
      "Models": {
        "gpt-5.1": { "CostPer1kTokensInput": 0.00093, "CostPer1kTokensCachedInput": 0.0001, "CostPer1kTokensOutput": 0.00741 }
      }
    }
  },
  "FeedbackLink": "https://forms.office.com/Pages/ResponsePage.aspx?id=yXfS-grGoU2187O4s0qC-SZtRygfwTNOqcfRq-MXpv9UOTIyQlNYR0hJT1Q0TUFVSlJGVFhES01LVC4u",
  "ChangeLink": "https://forms.office.com/Pages/ResponsePage.aspx?id=yXfS-grGoU2187O4s0qC-fkHK2JGo_BIpVChpLMaBFpUNUFDSzhQN0FHVklTV0JWTzFZTjNKWTNJUi4u",
  "GetHelpLink": "https://forms.office.com/Pages/ResponsePage.aspx?id=yXfS-grGoU2187O4s0qC-X7F89QcWu5CjlJXwF0TVktUMTFEUVRCVVg4WlMyS1AzUEJSUDAySlhQTCQlQCN0PWcu",
  "HowToUseLink": "https://educationgovuk.sharepoint.com/sites/lvewp00299/SitePages/complete-conversions-transfers-and-changes.aspx",
  "SupportEmail": "regionalservices.rg@education.gov.uk",
  "AccessibilityLink": "https://accessibility-statements.education.gov.uk"
} 