{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Error"
    },
    "Enrich": [ "FromLogContext" ]
  },
  "APPLICATIONINSIGHTS_CONNECTION_STRING": "",
  "AllowedHosts": "*",
  "Briefing": {
    "MaxEvidencePerSearch": 25,
    "MaxAcademiesPerTrust": 100,
    "OrphanAgentSweepEnabled": true,
    "OrphanAgentSweepTime": "01:00",
    "AgentVersionSweepEnabled": true,
    "AgentVersionSweepTime": "16:11"
  },
  "AzureAd": {
    "Instance": "https://login.microsoftonline.com/",
    "Domain": "Educationgovuk.onmicrosoft.com",
    "ClientID": "<set client id>",
    "TenantID": "<set tenant id>",
    "CallbackPath": "/signin-oidc"
  },
  "AiAgents": {
    "ApplicationName": "briefing-tool",
    "Foundry": {
      "Endpoint": "",
      "DefaultModel": "",
      "GatewayGuardrailErrors": [
        { "Status": 400, "Code": "model_error" }
      ]
    },
    "Authentication": {
      "TenantId": "",
      "ClientId": "",
      "ClientSecret": ""
    },
    "Guardrails": {
      "SubscriptionId": "",
      "ResourceGroup": "",
      "Name": "briefing-tool-guardrail",
      "Targets": "Agents",
      "BlockFrom": "Medium",
      "PromptShields": true,
      "IndirectAttacks": true,
      "ProtectedMaterial": true,
      "ScanPrompts": true,
      "ScanEvidence": true
    },
    "PromptFiles": {
      "SystemPrompts": {
        "Establishment": "Prompts/Systems/Establishment.md",
        "RiseConcerns": "Prompts/Systems/RiseConcerns.md",
        "RecastConcerns": "Prompts/Systems/RecastConcerns.md",
        "Trust": "Prompts/Systems/Trust.md",
        "WebSearch": "Prompts/Systems/WebSearch.md",
        "Synthesis": "Prompts/Systems/Synthesis.md"
      },
      "UserPrompts": {
        "Synthesis": "Prompts/Synthesis.md"
      }
    },
    "AISearch": {
      "Endpoint": "",
      "Authentication": {
        "TenantId": "",
        "ClientId": "",
        "ClientSecret": ""
      },
      "Indexes": [
        {
          "Name": "establishment_index",
          "ContentFields": []
        },
        {
          "Name": "trust_index",
          "ContentFields": []
        },
        { "Name": "rise_concerns_index" },
        { "Name": "recast_concerns_index" }
      ],
      "MinimumRelevanceFilter": 0.2,
      "MaxRetryAttempts": 3,
      "MaxEvidenceCharacters": 500000
    },
    "MaxEvidenceCharacters": 520000,
    "MaxToolOutputCharacters": 40000,
    "MaxOutputTokensPerRun": 64000,
    "FenceToolOutput": true,
    "MaxConcurrency": 4,
    "AgentCacheDuration": 30, 
    "KeepLatestVersions": 2,
    "ProtectedVersions": {},
    /*"GlobalConcurrency": {
      "MaxConcurrentRuns": 4,
      "BlobContainerUri": ""
    },*/
    "Pricing": {
      "Currency": "GBP",
      "Models": {
        "myconnection/gpt-5.1": {
          "CostPer1kTokensInput": 0.00093,
          "CostPer1kTokensCachedInput": 0.0001,
          "CostPer1kTokensOutput": 0.00741
        }
      }
    }
  },
  "FeedbackLink": "https://forms.office.com/Pages/ResponsePage.aspx?id=yXfS-grGoU2187O4s0qC-SZtRygfwTNOqcfRq-MXpv9UOTIyQlNYR0hJT1Q0TUFVSlJGVFhES01LVC4u",
